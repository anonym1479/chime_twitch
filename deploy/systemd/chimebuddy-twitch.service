[Unit]
Description=ChimeBuddy Twitch worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/bots/chimebuddy-v2
EnvironmentFile=%h/bots/chimebuddy-v2/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/bots/chimebuddy-v2/.venv/bin/chimebuddy-twitch
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
SyslogIdentifier=chimebuddy-twitch

[Install]
WantedBy=default.target
