[Unit]
Description=Create a verified ChimeBuddy database backup

[Service]
Type=oneshot
WorkingDirectory=%h/bots/chimebuddy-v2
EnvironmentFile=%h/bots/chimebuddy-v2/.env
ExecStart=%h/bots/chimebuddy-v2/.venv/bin/chimebuddy-backup-database --keep 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
SyslogIdentifier=chimebuddy-backup
